# Copy to .env. This file is intentionally Git-ignored.
# The runner uploads only the bundled, synthetic fixtures; it does not download external data.

# OpenShift AI / KFP access. Set either RHOAI_KFP_URL directly, or RHOAI_URL
# and let the runner discover the existing ds-pipeline OpenShift Route.
RHOAI_URL=https://api.YOUR-CLUSTER:6443
RHOAI_KFP_URL=
RHOAI_TOKEN=replace-with-your-openshift-token
RHOAI_PROJECT_NAME=YOUR-PROJECT
KFP_VERIFY_SSL=true
RHOAI_OPENSHIFT_API_VERIFY_SSL=true
RHOAI_OPENSHIFT_API_TIMEOUT_SECONDS=20
RHOAI_DSPA_ROUTE_PREFIX=ds-pipeline
KFP_EXPERIMENT_NAME=city-services-copilot

# S3-compatible storage used by this demo and its existing Kubernetes connections
AWS_S3_ENDPOINT=https://YOUR-S3-ENDPOINT
AWS_ACCESS_KEY_ID=replace-with-access-key
AWS_SECRET_ACCESS_KEY=replace-with-secret-key
AWS_DEFAULT_REGION=us-east-1
AWS_S3_BUCKET=YOUR-BUCKET
# Optional: use a different bucket/prefix for pipeline artifacts and leaderboards.
PIPELINE_ARTIFACTS_S3_BUCKET=
PIPELINE_ARTIFACTS_S3_PREFIX=
DEMO_S3_PREFIX=city-services-copilot
S3_SSL_VERIFY=true

# Existing Kubernetes secret names; the runner does not create or modify secrets.
AUTOML_S3_SECRET_NAME=s3-connection
AUTORAG_TEST_S3_SECRET_NAME=s3-connection
AUTORAG_DOCUMENTS_S3_SECRET_NAME=s3-connection
MAAS_SECRET_NAME=maas-connection
VECTOR_DB_SECRET_NAME=milvus-or-pgvector-connection

# Existing KServe storage connection and AutoGluon serving runtime. These are used
# only by the explicit --deploy command; no Kubernetes resources are created otherwise.
AUTOML_KSERVE_STORAGE_KEY=s3-connection
AUTOML_SERVING_RUNTIME_NAME=kserve-autogluonserver
# Optional override. Defaults to <AUTOML_KSERVE_STORAGE_KEY>-sa.
AUTOML_KSERVE_SERVICE_ACCOUNT=
AUTOML_DEPLOY_CPU=2
AUTOML_DEPLOY_MEMORY=4Gi
AUTOML_DEPLOY_TIMEOUT_SECONDS=600

# Required MaaS model IDs. Use JSON arrays or comma-separated values.
AUTORAG_EMBEDDING_MODELS=["YOUR-EMBEDDING-MODEL-ID"]
AUTORAG_GENERATION_MODELS=["YOUR-GENERATION-MODEL-ID"]

# Managed pipeline names. These defaults match the current AutoX CI defaults.
RHOAI_MANAGED_PIPELINE_TABULAR=autogluon-tabular-training-pipeline
RHOAI_MANAGED_PIPELINE_TIMESERIES=autogluon-timeseries-training-pipeline
RHOAI_MANAGED_PIPELINE_AUTORAG=documents-rag-optimization-pipeline

# Optional tuning values.
AUTOML_PRESET=speed
AUTORAG_PRESET=speed
AUTORAG_OPTIMIZATION_METRIC=unitxt:faithfulness
AUTORAG_MAX_RAG_PATTERNS=5
