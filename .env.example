# Copy to .env, fill only the values below, and keep the file Git-ignored.
# The runner uploads only bundled synthetic fixtures; it never downloads public data.

# OpenShift AI project. The runner discovers the project's existing ds-pipeline Route.
# Exported environment variables take precedence over this file.
# RHOAI_TOKEN must be current; deployment copies it into the app's scoring credentials.
# The app reads app-config.json at startup, not .env; restart it after config updates.
RHOAI_URL=https://api.YOUR-CLUSTER:6443
RHOAI_TOKEN=replace-with-your-openshift-token
RHOAI_PROJECT_NAME=YOUR-PROJECT

# S3-compatible object storage. These credentials upload demo inputs and read pipeline artifacts.
AWS_S3_ENDPOINT=https://YOUR-S3-ENDPOINT
AWS_ACCESS_KEY_ID=replace-with-access-key
AWS_SECRET_ACCESS_KEY=replace-with-secret-key
AWS_S3_BUCKET=YOUR-BUCKET

# One existing Kubernetes S3 connection used by AutoML, AutoRAG, and KServe deployment.
S3_CONNECTION_NAME=s3-connection

# Existing cluster connections required by the AutoRAG pipeline.
MAAS_SECRET_NAME=maas-connection
VECTOR_DB_SECRET_NAME=milvus-or-pgvector-connection

# MaaS model IDs required by AutoRAG. Use JSON arrays or comma-separated values.
AUTORAG_EMBEDDING_MODELS=["YOUR-EMBEDDING-MODEL-ID"]
AUTORAG_GENERATION_MODELS=["YOUR-GENERATION-MODEL-ID"]

# Advanced overrides are optional. See README.md for a complete list.
# Deploy a completed run: python3 scripts/setup_demo.py --deploy-autorag RUN_ID --apply
# Replace RUN_ID with the actual successful run ID; this does not rerun optimization.
# Submit, wait, and deploy: python3 scripts/setup_demo.py --only autorag --auto-deploy-autorag --apply
# Add --skip-upload to rerun with inputs already uploaded at the same bucket/keys.
# Requires a preinstalled Red Hat OpenShell gateway and running local Podman.
# The runner refreshes mTLS/registration and uses the RHOAI CLI container.
# Gateway/Sandbox resources are in openshell; project connections/builds stay in RHOAI_PROJECT_NAME.
# The runner supports the default openshell gateway namespace only.
# AutoRAG deployment uses the existing MaaS/database connections above and its indexed collection.
# Agent authentication is separate from RHOAI_TOKEN and MAAS_API_KEY; deployment writes it to app-config.json.
# AUTORAG_SANDBOX_NAME=city-services-rag
# AUTORAG_DEPLOY_TIMEOUT_SECONDS=1800
# AUTORAG_HEALTH_TIMEOUT_SECONDS=300
# RHOAI_CSV_NAMESPACE=redhat-ods-operator
# AUTORAG_BUILD_PULL_SECRET_NAME=pull-secret-brew
# RHOAI_OPENSHIFT_API_CA_BUNDLE=/absolute/path/to/cluster-ca.pem
